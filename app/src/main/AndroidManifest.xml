<?xml version="1.0" encoding="utf-8"?>
<!-- Archivo de manifiesto de configuración general de la aplicación -->

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Práctica Unidad 4"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar">

        <!-- Actividad Principal (Menú) que arranca por defecto -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla del Ejercicio 1 registrada -->
        <activity
            android:name=".Ejercicio1Activity"
            android:exported="false" />

        <!-- Pantalla del Ejercicio 2 registrada -->
        <activity
            android:name=".Ejercicio2Activity"
            android:exported="false" />

    </application>

</manifest>